        <mxCell id="WDnyjBc5Is8H3zblc84s-14" value="&lt;div&gt;Описание ЖК, цены, фото, тарифы ЖКХ&lt;/div&gt;&lt;div&gt;3-d тур без регистрации&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="280" width="120" height="80" as="geometry" />
        </mxCell>
        <mxCell id="WDnyjBc5Is8H3zblc84s-16" value="&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent;&quot;&gt;Техническая документация, логи приложений, API-контракты с партнёрами,&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;div&gt;конфигурации&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="270" y="280" width="120" height="85" as="geometry" />
        </mxCell>
        <mxCell id="WDnyjBc5Is8H3zblc84s-18" value="&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent;&quot;&gt;Данные клиентов и собственников: ФИО, телефон, email, история сделок&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="510" y="280" width="120" height="85" as="geometry" />
        </mxCell>
        <mxCell id="WDnyjBc5Is8H3zblc84s-20" value="&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent;&quot;&gt;Интеграции с госорганами (например, для сделок), финансовые документы,&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent;&quot;&gt;ИБ-политики&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="750" y="280" width="120" height="115" as="geometry" />
        </mxCell>
        <mxCell id="WDnyjBc5Is8H3zblc84s-32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="WDnyjBc5Is8H3zblc84s-24" target="WDnyjBc5Is8H3zblc84s-31">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="WDnyjBc5Is8H3zblc84s-24" value="утечка данных(незначительный)&lt;div&gt;потеря данных(значительный)&lt;/div&gt;&lt;div&gt;искажение данных(значительный)&lt;/div&gt;&lt;div&gt;некачественные данные(значительный)&lt;/div&gt;&lt;div&gt;обесценивание данных(значительный)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="50" y="410" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="WDnyjBc5Is8H3zblc84s-34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="WDnyjBc5Is8H3zblc84s-25" target="WDnyjBc5Is8H3zblc84s-33">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="WDnyjBc5Is8H3zblc84s-25" value="утечка данных(значительный)&lt;div&gt;потеря данных(не значительный)&lt;/div&gt;&lt;div&gt;искажение данных(значительный)&lt;/div&gt;&lt;div&gt;некачественные данные(значительный)&lt;/div&gt;&lt;div&gt;обесценивание данных(значительный)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="294" y="410" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="WDnyjBc5Is8H3zblc84s-36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="WDnyjBc5Is8H3zblc84s-27" target="WDnyjBc5Is8H3zblc84s-35">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="WDnyjBc5Is8H3zblc84s-27" value="утечка данных(критический)&lt;div&gt;потеря данных(значительный)&lt;/div&gt;&lt;div&gt;искажение данных(критический)&lt;/div&gt;&lt;div&gt;некачественные данные(значительный)&lt;/div&gt;&lt;div&gt;обесценивание данных(значительный)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="540" y="410" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="WDnyjBc5Is8H3zblc84s-38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="WDnyjBc5Is8H3zblc84s-29" target="WDnyjBc5Is8H3zblc84s-37">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="WDnyjBc5Is8H3zblc84s-29" value="утечка данных(критический)&lt;div&gt;потеря данных(критический)&lt;/div&gt;&lt;div&gt;искажение данных(критический)&lt;/div&gt;&lt;div&gt;некачественные данные(значительный)&lt;/div&gt;&lt;div&gt;обесценивание данных(значительный)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="790" y="410" width="250" height="100" as="geometry" />
        </mxCell>
        <mxCell id="WDnyjBc5Is8H3zblc84s-31" value="для публичных данных утечка данных не значительна, т.к. данные уже публичные,&lt;div&gt;потеря данных может вести к значительным потерям, поскольку пользователи не смогут взаимодействовать с объектами недвижимости, ввиду отсутствия, а значит оформлять сделки и продавать не получится, данные с ошибками, искаженные данные и не актуальные данные тоже могут привести к значительным потерям, ввод клиента в заблуждение, ошибка в цене, объекте и проч.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="50" y="530" width="240" height="250" as="geometry" />
        </mxCell>
        <mxCell id="WDnyjBc5Is8H3zblc84s-33" value="утечка данных может привести к значительным потерям в особенности при работе с логами, где может передаваться любая информация от персональных данных до каких то конфигураций и проч.&lt;div&gt;потер данных не значительный риск, но восстановление данных важно.&lt;/div&gt;&lt;div&gt;искажение значительно особенно при работе с API&lt;/div&gt;&lt;div&gt;не качественные данные тоже значительный при наличии ошибок и не соответствий, опять в рамках конфигураций и API с партнёрами&lt;/div&gt;&lt;div&gt;обесценивание тоже значительно особенно при смене API, конфигураций тех доков.&lt;br&gt;&lt;br&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="294" y="530" width="240" height="300" as="geometry" />
        </mxCell>
        <mxCell id="WDnyjBc5Is8H3zblc84s-35" value="утечка данных критически, риск жалоб штрафов репутационных потерь&lt;div&gt;потеря данных значительный(можно восстановить), риск срывания сделок, ошибки оплат&lt;/div&gt;&lt;div&gt;искажение критический, неверные персональные данные уже есть жалобы, ошибки.&lt;/div&gt;&lt;div&gt;не качественные данные значительный ошибки при регистрации как результат проблемы при оформлении операций по сделкам, в особенности при взаимодействии с СМЭВ&lt;/div&gt;&lt;div&gt;обесценивание данных значительнй, если данные потеряли свою актуальность и по ним проводится сделка это может привести к серьезным последствиям как для клиента так и для организации, например не обновили данные собственника при оформлении сделки, или перестала действовать нотариальная доверенность и т.д.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="540" y="530" width="240" height="360" as="geometry" />
        </mxCell>
        <mxCell id="WDnyjBc5Is8H3zblc84s-37" value="утечка данных, критический, возможность вмешательства сторонних лиц в сделки, нарушения закона.&lt;div&gt;потеря данных,&amp;nbsp; критический остановка бизнес процессов, возможно отсутствие первоисточника для восстановления.&lt;/div&gt;&lt;div&gt;искажение данных критический, может нарушать юридическую значимость, документов сделок оплат&lt;/div&gt;&lt;div&gt;не качественные данные значительный, те же проблемы при взаимодействии с СМЭВ, что и у конф данных.&lt;/div&gt;&lt;div&gt;обесценивание данных, значительный, может так же приводить к проблемам при оформлении сделок и оплат, например неактуальные гос реквезиты.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="790" y="530" width="240" height="270" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
